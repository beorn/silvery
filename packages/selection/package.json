{
  "name": "@silvery/selection",
  "version": "0.29.2",
  "description": "Pure selection state machine for silvery apps — node selection, sub-selection, pointer gestures",
  "license": "MIT",
  "author": "Bjorn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/silvery.git",
    "directory": "packages/selection"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@silvery/signals": "0.29.2"
  },
  "devDependencies": {
    "tsdown": "0.23.7",
    "typescript": "^5.9.3"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": "src/index.ts",
    "exports": {
      "devExports": true,
      "packageJson": false
    },
    "format": "esm"
  },
  "engines": {
    "node": ">=23.6.0"
  }
}
