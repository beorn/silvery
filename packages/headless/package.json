{
  "name": "@silvery/headless",
  "version": "0.26.0",
  "private": true,
  "description": "Pure state machines for UI components — no React, no rendering, no side effects",
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/silvery.git",
    "directory": "packages/headless"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./copy-mode": "./src/copy-mode.ts",
    "./history": "./src/history.ts",
    "./machine": "./src/machine.ts",
    "./pointer": "./src/pointer.ts",
    "./readline": "./src/readline.ts",
    "./select-list": "./src/select-list.ts",
    "./selection": "./src/selection.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./copy-mode": "./dist/copy-mode.mjs",
      "./history": "./dist/history.mjs",
      "./machine": "./dist/machine.mjs",
      "./pointer": "./dist/pointer.mjs",
      "./readline": "./dist/readline.mjs",
      "./select-list": "./dist/select-list.mjs",
      "./selection": "./dist/selection.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@silvery/ag": "0.26.0",
    "@silvery/ag-term": "0.26.0"
  },
  "peerDependenciesMeta": {
    "@silvery/ag": {
      "optional": true
    },
    "@silvery/ag-term": {
      "optional": true
    }
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.ts",
      "src/copy-mode.ts",
      "src/machine.ts",
      "src/pointer.ts",
      "src/readline.ts",
      "src/select-list.ts",
      "src/selection.ts",
      "src/history.ts"
    ],
    "format": "esm",
    "exports": {
      "devExports": true
    }
  },
  "inlinedDependencies": {
    "react": "19.3.1"
  }
}
