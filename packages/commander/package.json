{
  "name": "@silvery/commander",
  "version": "0.27.0",
  "description": "Colorized Commander.js help output using ANSI escape codes",
  "keywords": [
    "ansi",
    "cli",
    "color",
    "commander",
    "help"
  ],
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/silvery.git",
    "directory": "packages/commander"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./plain": "./src/plain.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./plain": "./dist/plain.mjs"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@silvery/ansi": "0.27.0",
    "commander": ">=15.0.0"
  },
  "devDependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.ts",
      "src/plain.ts"
    ],
    "exports": {
      "devExports": true,
      "packageJson": false
    },
    "external": [
      "commander",
      "zod",
      "@silvery/ansi"
    ],
    "format": "esm"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
