{
  "name": "@silvery/ansi",
  "version": "0.29.2",
  "description": "Everything terminal — styling, ANSI primitives, color detection, theme derivation, terminal control",
  "keywords": [
    "ansi",
    "chalk",
    "color",
    "detection",
    "no-color",
    "sgr",
    "style",
    "terminal",
    "theme"
  ],
  "homepage": "https://silvery.dev",
  "bugs": {
    "url": "https://github.com/beorn/silvery/issues"
  },
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/silvery.git",
    "directory": "packages/ansi"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemes": "./src/schemes/index.ts",
    "./schemes/detect": "./src/schemes/detect.ts",
    "./schemes/schemes": "./src/schemes/schemes/index.ts",
    "./schemes/theme": "./src/schemes/theme.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./schemes": "./dist/schemes/index.mjs",
      "./schemes/detect": "./dist/schemes/detect.mjs",
      "./schemes/schemes": "./dist/schemes/schemes/index.mjs",
      "./schemes/theme": "./dist/schemes/theme.mjs"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@silvery/color": "0.29.2",
    "string-width": "8.3.0"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.ts",
      "src/schemes/index.ts",
      "src/schemes/detect.ts",
      "src/schemes/schemes/index.ts",
      "src/schemes/theme.ts"
    ],
    "exports": {
      "devExports": true,
      "packageJson": false
    },
    "format": "esm"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
