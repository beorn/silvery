{
  "name": "@silvery/syntax",
  "version": "0.26.0",
  "description": "Shiki-backed syntax highlighting for silvery — ANSI tokens for terminal rendering and styled spans for web/canvas targets.",
  "keywords": [
    "ansi",
    "code",
    "highlight",
    "shiki",
    "syntax",
    "terminal",
    "tui"
  ],
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/silvery.git",
    "directory": "packages/syntax"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bounded-cache": "./src/bounded-cache.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./bounded-cache": "./dist/bounded-cache.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "lru-cache": "11.5.2",
    "shiki": "4.4.3"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.ts",
      "src/bounded-cache.ts"
    ],
    "format": "esm",
    "exports": {
      "devExports": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
