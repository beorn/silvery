{
  "name": "@silvery/color",
  "version": "0.29.2",
  "description": "Pure color math and Sterling design tokens — conversion, blending, contrast and paired CSS. Zero dependencies.",
  "keywords": [
    "color",
    "contrast",
    "hex",
    "hsl",
    "rgb",
    "wcag"
  ],
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/silvery.git",
    "directory": "packages/color"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./design": "./src/design/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./design": "./dist/design/index.mjs"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.ts",
      "src/design/index.ts"
    ],
    "exports": {
      "devExports": true,
      "packageJson": false
    },
    "format": "esm"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
