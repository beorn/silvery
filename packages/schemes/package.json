{
  "name": "@silvery/schemes",
  "version": "0.28.0",
  "description": "Terminal color schemes, detection, builders and import/export tools for Silvery",
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/silvery.git",
    "directory": "packages/schemes"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./detect": "./src/detect.ts",
    "./schemes": "./src/schemes/index.ts",
    "./theme": "./src/theme.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./detect": "./dist/detect.mjs",
      "./schemes": "./dist/schemes/index.mjs",
      "./theme": "./dist/theme.mjs"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@silvery/ansi": "0.28.0",
    "@silvery/color": "0.28.0",
    "@silvery/design": "0.28.0"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.ts",
      "src/detect.ts",
      "src/schemes/index.ts",
      "src/theme.ts"
    ],
    "exports": {
      "devExports": true,
      "packageJson": false
    },
    "format": "esm"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
