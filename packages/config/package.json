{
  "name": "@silvery/config",
  "version": "0.27.0",
  "description": "Generic config-tree + named-registry primitives with string ↔ object projection",
  "keywords": [
    "config",
    "connection-string",
    "preset",
    "registry",
    "silvery",
    "yaml"
  ],
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/silvery.git",
    "directory": "packages/config"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./commander": "./src/commander.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./commander": "./dist/commander.mjs"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@silvery/signals": "0.27.0",
    "cosmiconfig": "^9.0.2",
    "yaml": ">=2.0.0"
  },
  "devDependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@silvery/commander": "0.27.0",
    "zod": "^3.24.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@silvery/commander": {
      "optional": true
    }
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.ts",
      "src/commander.ts"
    ],
    "exports": {
      "devExports": true,
      "packageJson": false
    },
    "external": [
      "@silvery/commander",
      "alien-signals",
      "commander",
      "cosmiconfig",
      "yaml",
      "zod"
    ],
    "format": "esm"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
