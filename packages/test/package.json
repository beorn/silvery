{
  "name": "@silvery/test",
  "version": "0.26.0",
  "private": true,
  "description": "Testing utilities for silvery — virtual renderer, locators, assertions",
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/silvery.git",
    "directory": "packages/test"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "src/index.tsx",
  "exports": {
    ".": "./src/index.tsx",
    "./auto-locator": "./src/auto-locator.ts",
    "./compare-buffers": "./src/compare-buffers.ts",
    "./debug": "./src/debug.ts",
    "./debug-mismatch": "./src/debug-mismatch.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./auto-locator": "./dist/auto-locator.mjs",
      "./compare-buffers": "./dist/compare-buffers.mjs",
      "./debug": "./dist/debug.mjs",
      "./debug-mismatch": "./dist/debug-mismatch.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@silvery/ag": "0.26.0",
    "@silvery/ag-react": "0.26.0",
    "@silvery/ag-term": "0.26.0",
    "@silvery/create": "0.26.0",
    "@termless/core": ">=0.9.1 <1.0.0",
    "@termless/ghostty": ">=0.9.1 <1.0.0",
    "@termless/ghostty-native": ">=0.9.1 <1.0.0",
    "@termless/xtermjs": ">=0.9.1 <1.0.0"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.tsx",
      "src/auto-locator.ts",
      "src/compare-buffers.ts",
      "src/debug.ts",
      "src/debug-mismatch.ts"
    ],
    "format": "esm",
    "exports": {
      "devExports": true
    }
  },
  "engines": {
    "bun": ">=1.0",
    "node": ">=24.0.0"
  },
  "xtermjsIsReferenceOnly": "REFERENCE-ONLY (xterm.js): this is the differential oracle for the ANSI-fidelity harness — createTermless + the SILVERY_STRICT_TERMINAL cross-check. The production shell guest is vterm (@si/vterm/21016). Removing @termless/xtermjs does not retire xterm; it deletes the proof that vterm is correct. @pm/22783 Track 2.",
  "inlinedDependencies": {
    "boolbase": "2.0.0",
    "css-select": "7.0.0",
    "css-what": "8.0.0",
    "dom-serializer": "3.1.1",
    "domelementtype": "3.0.0",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "entities": "8.1.0",
    "nth-check": "3.0.1"
  }
}
