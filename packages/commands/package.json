{
  "name": "@silvery/commands",
  "version": "0.27.0",
  "private": true,
  "description": "Command registry, keymaps, and invocation for silvery apps",
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/silvery.git",
    "directory": "packages/commands"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./create-command-registry": "./src/create-command-registry.ts",
    "./with-commands": "./src/with-commands.ts",
    "./with-keybindings": "./src/with-keybindings.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./create-command-registry": "./dist/create-command-registry.mjs",
      "./with-commands": "./dist/with-commands.mjs",
      "./with-keybindings": "./dist/with-keybindings.mjs"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@silvery/ag": "0.27.0",
    "@silvery/command": "0.27.0"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.ts",
      "src/create-command-registry.ts",
      "src/with-commands.ts",
      "src/with-keybindings.ts"
    ],
    "exports": {
      "devExports": true,
      "packageJson": false
    },
    "format": "esm"
  }
}
