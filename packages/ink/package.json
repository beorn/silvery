{
  "name": "@silvery/ink",
  "version": "0.26.0",
  "private": true,
  "description": "Ink and Chalk API compatibility layer (not published separately)",
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./chalk": "./src/chalk.ts",
    "./ink": "./src/ink.ts",
    "./with-ink": "./src/with-ink.ts",
    "./with-ink-cursor": "./src/with-ink-cursor.ts",
    "./with-ink-focus": "./src/with-ink-focus.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./chalk": "./dist/chalk.mjs",
      "./ink": "./dist/ink.mjs",
      "./with-ink": "./dist/with-ink.mjs",
      "./with-ink-cursor": "./dist/with-ink-cursor.mjs",
      "./with-ink-focus": "./dist/with-ink-focus.mjs"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@silvery/ag-react": "0.26.0",
    "@silvery/ag-term": "0.26.0",
    "@silvery/ansi": "0.26.0"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.ts",
      "src/chalk.ts",
      "src/ink.ts",
      "src/with-ink.ts",
      "src/with-ink-cursor.ts",
      "src/with-ink-focus.ts"
    ],
    "exports": {
      "devExports": true,
      "packageJson": false
    },
    "format": "esm"
  },
  "inlinedDependencies": {
    "alien-signals": "3.2.1",
    "react": "19.3.1"
  }
}
