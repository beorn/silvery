{
  "name": "@silvery/command",
  "version": "0.25.1",
  "description": "Serializable command trees, registries, operations, and platform-neutral command nodes for every Silvery target",
  "keywords": [
    "command",
    "command-registry",
    "command-tree",
    "silvery"
  ],
  "license": "MIT",
  "author": "Bjorn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/silvery.git",
    "directory": "packages/command"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run tests",
    "typecheck": "tsc --noEmit"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": "src/index.ts",
    "format": "esm"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
