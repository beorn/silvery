{
  "name": "@silvery/theme",
  "version": "0.26.0",
  "private": true,
  "description": "Theming system with semantic color tokens for silvery (internal — use silvery/theme instead)",
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/silvery.git",
    "directory": "packages/theme"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./detect": "./src/detect.ts",
    "./schemes": "./src/schemes/index.ts",
    "./sterling": "./src/sterling/index.ts",
    "./theme": "./src/theme.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./detect": "./dist/detect.mjs",
      "./schemes": "./dist/schemes/index.mjs",
      "./sterling": "./dist/sterling/index.mjs",
      "./theme": "./dist/theme.mjs"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@silvery/ansi": "0.26.0",
    "@silvery/color": "0.26.0"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.ts",
      "src/detect.ts",
      "src/schemes/index.ts",
      "src/sterling/index.ts",
      "src/theme.ts"
    ],
    "format": "esm",
    "exports": {
      "devExports": true,
      "packageJson": false
    }
  }
}
