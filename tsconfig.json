{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "."
  },
  // `tests` and `packages/*/tests` are in the program on purpose. They were
  // outside it until 2026-08-19, which meant a required-field addition to a
  // widely-stubbed type (`AgNode.epochOwner`) compiled clean here and failed in
  // the host repo's typecheck instead — eleven fixtures, found at the merge gate
  // rather than at the author's desk. Whatever `bun run test` executes, this
  // gate reads.
  "include": ["src", "packages/*/src", "tests", "packages/*/tests", "../termless/src/**/*.d.ts"],
  // `tests/compat/ink/generated` is generated Ink-compat output, not authored
  // source; the host repo excludes it for the same reason.
  //
  // `*.fuzz.ts{x}` are FUZZ=1 and not in vitest include (see vitest.config.ts
  // `**/*.{test,spec}.{ts,tsx}`), so they are not in `bun run test`. Published
  // vimonkey@0.2.5 ships `dist/*.mjs` with tsdown `dts: false`, so a standalone
  // clone's tsc reports TS7016 on `vimonkey/fuzz`. Do not `declare module`
  // (that's an implicit any). Keep them out of this program until vimonkey
  // ships types.
  "exclude": ["node_modules", "dist", "tests/compat/ink/generated", "**/*.fuzz.ts", "**/*.fuzz.tsx"]
}
