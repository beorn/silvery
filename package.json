{
  "name": "silvery",
  "version": "0.26.0",
  "description": "React for modern terminal apps — powerful apps, polished UIs, proudly terminal",
  "keywords": [
    "ansi",
    "chalk",
    "cli",
    "flexbox",
    "ink",
    "ink-alternative",
    "react",
    "react-renderer",
    "react-terminal",
    "rendering",
    "terminal",
    "terminal-renderer",
    "terminal-ui",
    "text-ui",
    "tui",
    "ui"
  ],
  "homepage": "https://silvery.dev",
  "bugs": {
    "url": "https://github.com/beorn/silvery/issues"
  },
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/silvery.git"
  },
  "bin": {
    "silvery": "./bin/silvery.ts"
  },
  "workspaces": [
    "packages/*",
    "!examples"
  ],
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./chalk": "./src/chalk.ts",
    "./ink": "./src/ink.ts",
    "./runtime": "./src/runtime.ts",
    "./term": "./src/term.ts",
    "./test": "./src/test.ts",
    "./theme": "./src/theme.ts",
    "./ui": "./src/ui.ts",
    "./ui/animation": "./src/ui/animation.ts",
    "./ui/ansi": "./src/ui/ansi.ts",
    "./ui/cli": "./src/ui/cli.ts",
    "./ui/image": "./src/ui/image.ts",
    "./ui/progress": "./src/ui/progress.ts",
    "./ui/react": "./src/ui/react.ts",
    "./ui/recording-chrome": "./src/ui/recording-chrome.ts",
    "./ui/recording-chrome-react": "./src/ui/recording-chrome-react.ts",
    "./ui/utils": "./src/ui/utils.ts",
    "./ui/wrappers": "./src/ui/wrappers.ts"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "silvery": "./dist/bin/silvery.js"
    },
    "exports": {
      ".": "./dist/index.mjs",
      "./chalk": "./dist/chalk.mjs",
      "./ink": "./dist/ink.mjs",
      "./runtime": "./dist/runtime.mjs",
      "./term": "./dist/term.mjs",
      "./test": "./dist/test.mjs",
      "./theme": "./dist/theme.mjs",
      "./ui": "./dist/ui.mjs",
      "./ui/animation": "./dist/ui/animation.mjs",
      "./ui/ansi": "./dist/ui/ansi.mjs",
      "./ui/cli": "./dist/ui/cli.mjs",
      "./ui/image": "./dist/ui/image.mjs",
      "./ui/progress": "./dist/ui/progress.mjs",
      "./ui/react": "./dist/ui/react.mjs",
      "./ui/recording-chrome": "./dist/ui/recording-chrome.mjs",
      "./ui/recording-chrome-react": "./dist/ui/recording-chrome-react.mjs",
      "./ui/utils": "./dist/ui/utils.mjs",
      "./ui/wrappers": "./dist/ui/wrappers.mjs"
    }
  },
  "scripts": {
    "build": "tsdown && bun build ./bin/silvery.ts --target=node --outfile ./dist/bin/silvery.js && bun scripts/publish-shebang.ts",
    "prepack": "bun run build",
    "build:all": "bun run build && tsdown -W -F '@silvery/ag' -F '@silvery/ag-react' -F '@silvery/ag-term' -F '@silvery/ansi' -F '@silvery/color' -F '@silvery/command' -F '@silvery/commander' -F '@silvery/commands' -F '@silvery/config' -F '@silvery/create' -F '@silvery/headless' -F '@silvery/ink' -F '@silvery/scope' -F '@silvery/selection' -F '@silvery/signals' -F '@silvery/syntax' -F '@silvery/theme'",
    "test": "NODE_ENV=test BUN_RUNTIME_TRANSPILER_CACHE_PATH=\"${HOME}/.cache/silvercode/bun-transpiler-silvery-test\" bunx --bun vitest run",
    "test:fast": "NODE_ENV=test BUN_RUNTIME_TRANSPILER_CACHE_PATH=\"${HOME}/.cache/silvercode/bun-transpiler-silvery-test\" bunx --bun vitest run --reporter=dot",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && oxfmt --check . && bun scripts/lint-env-reads.ts && bun scripts/lint-no-raw-mode.ts && bun scripts/lint-no-async-unmount.ts && bun scripts/lint-no-in-flight-rect-in-app.ts",
    "lint:env-reads": "bun scripts/lint-env-reads.ts",
    "lint:raw-mode": "bun scripts/lint-no-raw-mode.ts",
    "lint:async-unmount": "bun scripts/lint-no-async-unmount.ts",
    "lint:in-flight-rect": "bun scripts/lint-no-in-flight-rect-in-app.ts",
    "fix": "oxlint --fix . && oxfmt --write .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:gen": "bun scripts/gen-token-docs.ts && oxfmt docs/reference/tokens.md",
    "docs:check": "bun run docs:gen && git diff --exit-code docs/reference/tokens.md",
    "theme": "bun packages/theme/src/cli.ts",
    "demo": "bun examples/bin/cli.ts",
    "example:storybook": "bun examples/apps/storybook/index.tsx",
    "compat": "bun packages/ink/scripts/compat-check.ts",
    "compat:ink": "bun packages/ink/scripts/compat-check.ts ink",
    "compat:chalk": "bun packages/ink/scripts/compat-check.ts chalk",
    "bench": "cd benchmarks && bun run bench",
    "bench:compare": "cd benchmarks && bun run bench:compare"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@silvery/color": "0.26.0",
    "@silvery/commander": "0.26.0",
    "@silvery/syntax": "0.26.0",
    "@termless/core": ">=0.9.1 <1.0.0",
    "css-select": "^7.0.0",
    "css-what": "^8.0.0",
    "flexily": "^0.8.3",
    "loggily": "^0.10.2",
    "react-reconciler": "^0.33.0",
    "slice-ansi": "^9.0.1",
    "string-width": "^8.3.0"
  },
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@silvery/ag": "0.26.0",
    "@silvery/ag-react": "0.26.0",
    "@silvery/ag-term": "0.26.0",
    "@silvery/ansi": "0.26.0",
    "@silvery/theme": "0.26.0",
    "@termless/ghostty": ">=0.9.1 <1.0.0",
    "@termless/ghostty-native": ">=0.9.1 <1.0.0",
    "@termless/test": ">=0.9.1 <1.0.0",
    "@termless/xtermjs": ">=0.9.1 <1.0.0",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@vue/server-renderer": "3.5.43",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chalk": "^5.6.2",
    "cytoscape": "3.34.3",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "1.11.23",
    "fast-check": "4.10.2",
    "ink": "^7.1.0",
    "mermaid": "^11.14.0",
    "mitata": "^1.0.34",
    "oxfmt": "0.38.0",
    "oxlint": "1.85.0",
    "playwright": "1.64.1",
    "react": "^19.0.0",
    "rolldown": "1.2.12",
    "silvery": "link:.",
    "tsdown": "0.22.13",
    "typescript": "^5.5.0",
    "vimonkey": "^0.2.0",
    "vite-plus": "^0.1.16",
    "vitepress": "^1.5.0",
    "vitepress-enrich": "^0.4.1",
    "vitepress-plugin-d2": "^1.1.0",
    "vitepress-plugin-diagrams": "^1.2.2",
    "vitepress-plugin-llms": "1.14.0",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "5.0.4",
    "vue": "3.5.43",
    "yoga-wasm-web": "^0.3.3"
  },
  "peerDependencies": {
    "@termless/ghostty": ">=0.9.1 <1.0.0",
    "@termless/ghostty-native": ">=0.9.1 <1.0.0",
    "@termless/test": ">=0.9.1 <1.0.0",
    "@termless/xtermjs": ">=0.9.1 <1.0.0",
    "playwright": ">=1.40.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@termless/ghostty": {
      "optional": true
    },
    "@termless/ghostty-native": {
      "optional": true
    },
    "@termless/test": {
      "optional": true
    },
    "@termless/xtermjs": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "resolutions": {
    "flexily": "0.8.3",
    "loggily": "^0.10.2"
  },
  "tsdown": {
    "clean": true,
    "deps": {
      "alwaysBundle": [
        "slice-ansi"
      ]
    },
    "dts": {
      "eager": true
    },
    "entry": [
      "src/index.ts",
      "src/runtime.ts",
      "src/term.ts",
      "src/theme.ts",
      "src/test.ts",
      "src/ui.ts",
      "src/ink.ts",
      "src/chalk.ts",
      "src/ui/animation.ts",
      "src/ui/ansi.ts",
      "src/ui/cli.ts",
      "src/ui/image.ts",
      "src/ui/progress.ts",
      "src/ui/react.ts",
      "src/ui/recording-chrome-react.ts",
      "src/ui/recording-chrome.ts",
      "src/ui/utils.ts",
      "src/ui/wrappers.ts"
    ],
    "exports": {
      "devExports": true,
      "packageJson": false
    },
    "format": "esm"
  },
  "engines": {
    "bun": ">=1.0",
    "node": ">=24.0.0"
  },
  "inlinedDependencies": {
    "alien-signals": "3.2.1",
    "ansi-styles": "6.2.3",
    "get-east-asian-width": "1.6.0",
    "is-fullwidth-code-point": "5.1.0",
    "pako": "1.0.11",
    "react-devtools-core": "7.0.1",
    "slice-ansi": "9.0.1",
    "upng-js": "2.1.0",
    "ws": "8.22.0",
    "yoga-wasm-web": "0.3.3"
  },
  "patchedDependencies": {
    "slice-ansi@9.0.1": "patches/slice-ansi@9.0.1.patch"
  },
  "verifyPublishable": {
    "build": "bun run build:all",
    "public": [
      "silvery",
      "@silvery/ansi",
      "@silvery/color",
      "@silvery/command",
      "@silvery/commander",
      "@silvery/config",
      "@silvery/scope",
      "@silvery/selection",
      "@silvery/signals",
      "@silvery/syntax"
    ]
  },
  "xtermjsIsReferenceOnly": "REFERENCE-ONLY (xterm.js): this is the differential oracle for the ANSI-fidelity harness — createTermless + the SILVERY_STRICT_TERMINAL cross-check. The production shell guest is vterm (@si/vterm/21016). Removing @termless/xtermjs does not retire xterm; it deletes the proof that vterm is correct. @pm/22783 Track 2."
}
